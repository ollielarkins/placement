# Direct (or session pooler) connection for the postgres role. Used only by
# the import scripts on your machine; never shipped to the browser or Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Find an apprenticeship Display Advert API v2, unfiltered subscription key.
FAA_API_KEY=<key>

# Contact crawler (npm run crawl:contacts, npm run colleges:link): a URL or
# email address a website owner can use to reach you. It goes in the crawler's
# User-Agent, so use a project address, not a personal one.
CRAWLER_CONTACT=
